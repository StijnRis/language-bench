  "versions": [
    {
      "version": "5.42",
      "latest": true
    },
    {
      "version": "5.40",
      "latest": false
    },
    {
      "version": "5.38",
      "latest": false
    },
    {
      "version": "5.36",
      "latest": false
    },
    {
      "version": "5.34",
      "latest": false
    }
  ],
  "variants": [
    {
      "id": "perl-default",
      "name": "perl",
      "description": "Default interpreter.",
      "run": "perl {src}/main.pl",
      "default": true
    }
  ],
  "versionSource": {
    "kind": "github-tags",
    "repo": "Perl/perl5",
    "pattern": "^v(5\\.\\d*[02468])\\.0$",
    "url": "https://www.perl.org/get.html",
    "minVersion": "5.34"
  }
