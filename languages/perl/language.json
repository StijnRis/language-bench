{
  "id": "perl",
  "name": "Perl",
  "highlight": "perl",
  "website": "https://www.perl.org/",
  "description": "Perl 5: a bytecode-compiled interpreter with reference counting, strong built-in string and hash support and the original scripting-language regular expressions.",
  "color": {
    "light": "#0e7490",
    "dark": "#67e8f9"
  },
  "sourceFile": "main.pl",
  "image": "perl:{version}",
