    {
      "version": "8.2",
      "latest": false
    },
    {
      "version": "8.1",
      "latest": false
    },
    {
      "version": "8.0",
      "latest": false
    },
    {
      "version": "7.4",
      "latest": false
    }
  ],
  "variants": [
    {
      "id": "php-default",
      "name": "php -d memory_limit=-1",
      "description": "Default interpreter without OPcache or JIT; only the memory limit is lifted.",
      "run": "php -d memory_limit=-1 {harness}/harness.php {src}/main.php",
      "default": true
    }
