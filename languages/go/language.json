{
  "id": "go",
  "name": "Go",
  "highlight": "go",
  "website": "https://go.dev/",
  "description": "Go compiled ahead-of-time by the gc toolchain, with a concurrent garbage collector and goroutines.",
  "color": {
    "light": "#0891b2",
    "dark": "#22d3ee"
  },
  "sourceFile": "main.go",
  "image": "golang:{version}",
  "toolVersionCmd": "go version",
  "versions": [
    {
      "version": "1.27",
      "latest": true
    },
    {
      "version": "1.26",
      "latest": false
    },
    {
      "version": "1.24",
      "latest": false
    },
    {
      "version": "1.22",
      "latest": false
    },
    {
      "version": "1.21",
      "latest": false
    }
  ],
  "variants": [
    {
      "id": "go-default",
      "name": "go build",
      "description": "Default toolchain settings (GOAMD64=v1).",
      "build": "mkdir -p {bin}.d && cp {harness}/harness.go {bin}.d/harness.go && cp {src}/main.go {bin}.d/problem.go && go build -o {bin} {bin}.d/harness.go {bin}.d/problem.go",
      "run": "{bin}",
      "default": true
    },
    {
      "id": "go-amd64-v3",
      "name": "GOAMD64=v3 go build",
      "description": "Allows AVX2/BMI/FMA instructions on x86-64.",
      "build": "mkdir -p {bin}.d && cp {harness}/harness.go {bin}.d/harness.go && cp {src}/main.go {bin}.d/problem.go && GOAMD64=v3 go build -o {bin} {bin}.d/harness.go {bin}.d/problem.go",
      "run": "{bin}"
    }
  ],
  "versionSource": {
    "kind": "github-tags",
    "repo": "golang/go",
    "pattern": "^go(1\\.\\d+)(?:\\.0)?$",
    "url": "https://go.dev/doc/devel/release",
    "minVersion": "1.21"
  }
}
