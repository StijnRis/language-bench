{
  "id": "python",
  "name": "Python (CPython)",
  "highlight": "python",
  "website": "https://www.python.org/",
  "description": "The reference CPython interpreter: bytecode interpreter with reference counting and a cycle collector.",
  "sourceFile": "main.py",
  "image": "python:{version}",
  "toolVersionCmd": "python3 --version",
  "versions": [
    {
      "version": "3.14",
      "latest": true
    },
    {
      "version": "3.13",
      "latest": false
    },
    {
      "version": "3.12",
      "latest": false
    }
  ],
  "variants": [
    {
      "id": "cpython-default",
      "name": "python3",
      "description": "Default interpreter.",
      "run": "python3 {src}/main.py",
      "default": true
    }
  ],
  "versionSource": {
    "kind": "github-tags",
    "repo": "python/cpython",
    "pattern": "^v(3\\.\\d+)\\.0$",
    "url": "https://www.python.org/downloads/"
  }
}
