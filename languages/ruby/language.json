{
  "id": "ruby",
  "name": "Ruby",
  "highlight": "ruby",
  "website": "https://www.ruby-lang.org/",
  "description": "The reference CRuby (MRI) interpreter: bytecode VM with a global VM lock and a generational, incremental garbage collector. Optional YJIT compiler.",
  "color": {
    "light": "#db2777",
    "dark": "#f472b6"
  },
  "sourceFile": "main.rb",
  "image": "ruby:{version}",
  "toolVersionCmd": "ruby --version",
