  "variants": [
    {
      "id": "ruby-default",
      "name": "ruby",
      "description": "Default interpreter, JIT off.",
      "run": "ruby {src}/main.rb",
      "default": true
    },
    {
      "id": "ruby-yjit",
      "name": "ruby --yjit",
      "description": "Enables YJIT, the built-in JIT compiler.",
      "run": "ruby --yjit {src}/main.rb",
      "minVersion": "3.1"
    }
  ],
  "versionSource": {
    "kind": "github-tags",
    "repo": "ruby/ruby",
    "pattern": "^v(\\d+[._]\\d+)[._]0$",
    "url": "https://www.ruby-lang.org/en/downloads/branches/",
    "minVersion": "2.4"
  }
